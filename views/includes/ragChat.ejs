<!-- RAG AI Concierge Drawer -->
<button id="rag-toggle-btn" type="button" aria-label="Ask EDITH AI">
  <i class="fa-solid fa-sparkles"></i>
  <span>EDITH</span>
</button>

<div id="rag-drawer" class="rag-drawer" aria-hidden="true">
  <div class="rag-header">
    <div class="rag-header-title">
      <i class="fa-brands fa-airbnb"></i>
      <span>EDITH — AI Concierge</span>
    </div>
    <button id="rag-close-btn" type="button" aria-label="Close chat">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <div class="rag-quick-prompts">
    <button class="rag-chip" type="button" data-prompt="Find a villa with a pool">Pool villa</button>
    <button class="rag-chip" type="button" data-prompt="Stays under 1500 per night">Budget friendly</button>
    <button class="rag-chip" type="button" data-prompt="Beachfront stay in Bali">Bali beachfront</button>
    <button class="rag-chip" type="button" data-prompt="What's your cancellation policy?">Cancellation</button>
    <button class="rag-chip" type="button" data-prompt="How do I create an account?">How to sign up</button>
  </div>

  <div id="rag-messages" class="rag-messages">
<div class="rag-message rag-bot">
        <div class="rag-avatar"><i class="fa-solid fa-robot"></i></div>
        <div class="rag-bubble">
          Hello! I'm <strong>E.D.I.T.H.</strong>, WanderLust's AI concierge.
          Ask me for stays — <em>"villa with a pool in Phuket"</em>,
          <em>"stays under ₹1500"</em> — or anything about the site:
          <em>"what's your cancellation policy?"</em>, <em>"how do I book?"</em>.
        </div>
      </div>
  </div>

  <div class="rag-input-container">
    <form id="rag-form">
      <input type="text" id="rag-input" placeholder="Ask EDITH..." autocomplete="off" required />
      <button type="submit" id="rag-send-btn" aria-label="Send"><i class="fa-solid fa-paper-plane"></i></button>
    </form>
  </div>
</div>